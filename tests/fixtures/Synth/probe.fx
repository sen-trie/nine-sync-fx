float3 Tint < string UIName = "Tint"; string UIWidget = "Color"; > = float3(1, 0.5, 0.25);
float Spread < string UIWidget = "Slider"; float UIMin = 0; float UIMax = 10; > = 2.5;
bool Hidden < bool UIVisible = false; > = true;
int Copies = 4;
int index;
float Time : TIME;
float Elapsed : ELAPSEDTIME;
float2 Viewport : VIEWPORTPIXELSIZE;
float3 LightDir : DIRECTION < string Object = "Light"; >;
float3 LightPos : POSITION < string Object = "Light"; >;
float3 CamPos : POSITION < string Object = "Camera"; >;
float3 CamDir : DIRECTION < string Object = "Camera"; >;
float4x4 WVP : WORLDVIEWPROJECTION;
float4x4 LWVP : WORLDVIEWPROJECTION < string Object = "Light"; >;
float4x4 VI : VIEWINVERSE;
float4x4 WIT : WORLDINVERSETRANSPOSE;
float4x4 WV : WORLDVIEW;
float4x4 SelfM : CONTROLOBJECT < string name = "(self)"; >;
float3 SelfXYZ : CONTROLOBJECT < string name = "(self)"; string item = "XYZ"; >;
float SelfRx : CONTROLOBJECT < string name = "(self)"; string item = "Rx"; >;
float Tr : CONTROLOBJECT < string name = "(self)"; string item = "Tr"; >;
float Si : CONTROLOBJECT < string name = "(self)"; string item = "Si"; >;
float3 LightColor : SPECULAR < string Object = "Light"; >;
float4x4 BoneM : CONTROLOBJECT < string name = "Model.pmx"; string item = "Bone"; >;
float3 BonePos : CONTROLOBJECT < string name = "Model.pmx"; string item = "Bone"; >;
float3 Other : CONTROLOBJECT < string name = "other.x"; >;
float MorphW : CONTROLOBJECT < string name = "Model.pmx"; string item = "Smile"; >;
static float weights[4] = {0.1, 0.2, 0.3, 0.4};

struct VS_OUT { float4 Pos : POSITION;
    float4 D0 : TEXCOORD2;
    float4 D1 : TEXCOORD3;
    float4 D2 : TEXCOORD4;
    float4 D3 : TEXCOORD5;
    float4 D4 : TEXCOORD6;
    float4 D5 : TEXCOORD7;
    float4 D6 : TEXCOORD8;
    float4 D7 : TEXCOORD9;
    float4 D8 : TEXCOORD10;
    float4 D9 : TEXCOORD11;
    float4 D10 : TEXCOORD12;
    float4 D11 : TEXCOORD13;
    float4 D12 : TEXCOORD14;
    float4 D13 : TEXCOORD15;
    float4 D14 : TEXCOORD16;
    float4 D15 : TEXCOORD17;
    float4 D16 : TEXCOORD18;
    float4 D17 : TEXCOORD19;
    float4 D18 : TEXCOORD20;
};
VS_OUT VS(float4 Pos : POSITION, float2 Tex : TEXCOORD0)
{
    VS_OUT o = (VS_OUT)0;
    int k = index;
    float acc = 0;
    for (int i = 0; i < 4; i++) { acc += weights[i] * (i == (k & 3) ? 2 : 1); }
    float4 lp = mul(float4(Pos.xyz, 1), LWVP);
    o.Pos = mul(float4(Pos.xyz, 1), WVP);
    o.D0.x = k & 3;
    o.D0.y = k % 3;
    o.D0.z = k / 3;
    o.D0.w = k >> 1;
    o.D1.x = k << 1;
    o.D1.y = (k ^ 5) | 2;
    o.D1.z = weights[k & 3];
    o.D1.w = acc;
    o.D2.x = sin(Time * 3 + k);
    o.D2.y = SelfRx;
    o.D2.z = SelfXYZ.x;
    o.D2.w = SelfXYZ.y;
    o.D3.x = SelfXYZ.z;
    o.D3.y = mul(float4(1, 0, 0, 0), SelfM).x;
    o.D3.z = mul(float4(1, 0, 0, 0), SelfM).y;
    o.D3.w = mul(float4(1, 0, 0, 0), SelfM).z;
    o.D4.x = LightDir.x;
    o.D4.y = LightDir.y;
    o.D4.z = LightDir.z;
    o.D4.w = (!(k < 2) && Tr > 0.3 || k == 0) ? 1 : 0;
    o.D5.x = Elapsed;
    o.D5.y = Viewport.y;
    o.D5.z = mul(VI[3], WIT).y;
    o.D5.w = CamPos.y;
    o.D6.x = CamDir.y;
    o.D6.y = LightPos.y;
    o.D6.z = LightColor.y;
    o.D6.w = mul(float4(Pos.xyz, 1), WV).y;
    o.D7.x = lp.z / lp.w;
    o.D7.y = Si;
    o.D7.z = Tr;
    o.D7.w = Spread;
    o.D8.x = BoneM[0].x;
    o.D8.y = BoneM[1].y;
    o.D8.z = BoneM[2].z;
    o.D8.w = BoneM[3].x;
    o.D9.x = BoneM[3].y;
    o.D9.y = BoneM[3].z;
    o.D9.z = BoneM[0].z;
    o.D9.w = BonePos.x;
    o.D10.x = BonePos.y;
    o.D10.y = BonePos.z;
    o.D10.z = Other.x;
    o.D10.w = Other.y;
    o.D11.x = Other.z;
    o.D11.y = MorphW;
    o.D11.z = smoothstep(0.2, 0.8, frac(Time));
    o.D11.w = smoothstep(Si * 0.1, Tr, 0.3);
    o.D12.x = lerp(SelfXYZ, CamPos, Tr).x;
    o.D12.y = lerp(SelfXYZ, CamPos, Tr).z;
    o.D12.z = lerp(Tr, Si, frac(Time));
    o.D12.w = lerp(SelfXYZ, CamPos, LightDir).y;
    o.D13.x = normalize(CamPos - SelfXYZ).x;
    o.D13.y = normalize(CamPos - SelfXYZ).y;
    o.D13.z = cross(LightDir, CamDir).x;
    o.D13.w = cross(LightDir, CamDir).z;
    o.D14.x = length(CamPos - SelfXYZ);
    o.D14.y = distance(CamPos, SelfXYZ);
    o.D14.z = dot(LightDir, CamDir);
    o.D14.w = reflect(LightDir, CamDir * 2).y;
    o.D15.x = saturate(Tr * 3 - 1);
    o.D15.y = clamp(frac(Time) * 3, Tr, Si);
    o.D15.z = saturate(CamDir).y;
    o.D15.w = mul(float4(CamPos, 1), WVP).w;
    o.D16.x = mul(WVP, float4(CamPos, 1)).y;
    o.D16.y = mul(WVP, VI)[2].z;
    o.D16.z = mul(VI, WVP)[3].x;
    o.D16.w = normalize(float4(CamPos, Tr)).w;
    o.D17.x = length(float4(CamPos, Tr));
    o.D17.y = mul(CamPos, (float3x3)WV).y;
    o.D17.z = mul((float3x3)WV, CamPos).z;
    o.D17.w = mul((float3x3)VI, (float3x3)WV)[1].y;
    o.D18.x = mul(CamPos, WVP).w;
    o.D18.y = mul(CamPos, WVP).x;
    o.D18.z = mul(LightDir, (float3x3)SelfM).x;
    return o;
}
float4 PS(VS_OUT IN) : COLOR0 { return IN.D0 + IN.D1 + IN.D2 + IN.D3 + IN.D4 + IN.D5 + IN.D6 + IN.D7 + IN.D8 + IN.D9 + IN.D10 + IN.D11 + IN.D12 + IN.D13 + IN.D14 + IN.D15 + IN.D16 + IN.D17 + IN.D18; }
technique T < string MMDPass = "object"; string Script = "LoopByCount=Copies; LoopGetIndex=index; Pass=P0; LoopEnd=;"; > { pass P0 { VertexShader = compile vs_3_0 VS(); PixelShader = compile ps_3_0 PS(); } }
